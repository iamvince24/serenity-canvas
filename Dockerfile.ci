# Digest pinned 2026-06-06; Dependabot docker ecosystem tracks updates
FROM node:26-bookworm-slim@sha256:79723b41edbedf595f62e943a9f8b0ba9af5b1e61045c5f8f59c2c02c1212a16

WORKDIR /app

ENV CI=true
ENV HUSKY=0

RUN corepack enable && corepack prepare pnpm@9.6.0 --activate

# Layer 1: workspace manifests (stable dependency install cache)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/web/package.json apps/web/
COPY apps/site/package.json apps/site/
COPY apps/mcp-server/package.json apps/mcp-server/
COPY packages/shared/package.json packages/shared/

RUN pnpm install --frozen-lockfile

# Layer 2: full source (.dockerignore excludes secrets and local artifacts)
COPY . .

# Pre-build workspace packages imported by tests (e.g. @serenity/mcp-server/heightEstimator)
RUN pnpm exec turbo build --filter=@serenity/mcp-server

CMD ["pnpm", "typecheck"]
